{
  "manifest_version": 3,
  "name": "Pixel & Tag Checker: GA4, GTM, Meta Audit \u2013 The Growth Folks\u00ae",
  "short_name": "Tag Checker",
  "version": "1.2.0",
  "description": "Check GA4, GTM, Meta, TikTok and ChatGPT Ads pixels, see what fires before consent, and send clients a polished audit report.",
  "homepage_url": "https://thegrowthfolks.com/tools/tag-checker/",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "webRequest",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://thegrowthfolks.com/*"
    ]
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "Open Pixel & Tag Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_permissions": [
    "browsingData",
    "alarms",
    "notifications"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/dl-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/wpm@*",
        "https://*/web-pixels@*",
        "http://*/wpm@*",
        "http://*/web-pixels@*"
      ],
      "js": [
        "src/content/dl-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*/wpm@*",
        "https://*/web-pixels@*",
        "http://*/wpm@*",
        "http://*/web-pixels@*"
      ],
      "js": [
        "src/content/relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
